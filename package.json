{
  "name": "questboard",
  "productName": "Questboard",
  "version": "0.3.0",
  "description": "Game-themed questboard that opens with Windows. Your quests, not your chores.",
  "main": "src/main.js",
  "author": "Mild-Solvent",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mildsolvent.questboard",
    "productName": "Questboard",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "publish": { "provider": "github", "owner": "Mild-Solvent", "repo": "Questboard", "releaseType": "release" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Questboard-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Questboard"
    }
  }
}
